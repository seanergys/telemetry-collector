set -euo pipefail

copyright_text='SPDX-FileCopyrightText: 2026 SEANERGYS Partners <https://seanergys.eu>'
license_text='SPDX-License-Identifier: EUPL-1.2'
failed=0

staged_header() {
    local file="$1"

    git show ":$file" 2>/dev/null |
        sed -n '1,12{s/<!--//g;s/-->//g;s/^[[:space:]]*\/\/[[:space:]]*//;s/^[[:space:]]*#[[:space:]]*//;s/^[[:space:]]*\/\*[[:space:]]*//;s/^[[:space:]]*\*[[:space:]]*//;s/^[[:space:]]*--[[:space:]]*//;s/^[[:space:]]*;[[:space:]]*//;p;}'
}

has_notices() {
    local file="$1"
    local header

    header="$(staged_header "$file")" || return 1
    [[ "$header" == *"$copyright_text"* && "$header" == *"$license_text"* ]]
}

has_licensed_symlink_target() {
    local file="$1"
    local entry link target

    entry="$(git --literal-pathspecs ls-files --stage -- "$file")" || return 1
    [[ "$entry" == '120000 '* ]] || return 1
    link="$(git show ":$file")" || return 1
    [[ -n "$link" && "$link" != /* ]] || return 1

    # Resolve the staged relative path without following working-tree symlinks.
    target="$(realpath -ms --relative-to=. -- "$(dirname -- "$file")/$link")" || return 1
    [[ "$target" != '..' && "$target" != ../* ]] || return 1
    entry="$(git --literal-pathspecs ls-files --stage -- "$target")" || return 1
    [[ "$entry" == '100644 '* || "$entry" == '100755 '* ]] || return 1
    has_notices "$target" || has_notices "$target.license"
}

while IFS= read -r -d '' file; do
    if [[ "$file" == "LICENSE" ]]; then
        continue
    fi

    if [[ "$file" == *.license ]]; then
        if has_notices "$file"; then
            continue
        fi
    elif has_notices "$file" || has_notices "$file.license" || has_licensed_symlink_target "$file"; then
        continue
    fi

    printf 'Missing SPDX copyright and EUPL-1.2 header: %s\n' "$file" >&2
    printf 'Add the notices at the top, or add a matching .license sidecar.\n' >&2
    failed=1
done < <(git diff --cached --name-only --diff-filter=A -z --)

exit "$failed"
