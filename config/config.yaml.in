seanerbus:
  url: seanerbroker://10.42.0.69:5398

# Log currently loaded plugins at info level at this interval (milliseconds).
# Set to 0 to disable periodic reporting.
plugin_status_interval_ms: 1000

plugins:
  - path: @TC_PLUGIN_DIR@/mock.so
    config: @TC_CONFIG_DIR@/mock.yaml
    uuid: e94e6e91-a83d-4e04-a147-aab3860d0cd2
    name: mock
  - path: @TC_PLUGIN_DIR@/sysfs.so
    config: @TC_CONFIG_DIR@/sysfs.yaml
    uuid: e94e6e91-a83d-4e04-a147-aab3860d0cd7
    name: sysfs
  - path: @TC_PLUGIN_DIR@/tester.so
    config: @TC_CONFIG_DIR@/tester.yaml
    uuid: e94e6e91-a83d-4e04-a147-aab3860d0cd9
    name: tester
  - path: @TC_PLUGIN_DIR@/snmp.so
    config: @TC_CONFIG_DIR@/snmp.yaml
    uuid: e94e6e91-a83d-4e04-a147-aab3860d0cd8
    name: snmp
  - path: @TC_PLUGIN_DIR@/ad.so
    config: @TC_CONFIG_DIR@/ad.yaml
    uuid: e94e6e91-a83d-4e04-a147-aab3860d0cd3
    name: ad
